node_modules/
.pnpm-store/

dist/
build/
out/

# Astro's generated route and content-collection types (apps/website), written by
# `astro sync` — which `astro check` runs for us, so there is nothing to commit.
.astro/

# SQLite databases
*.db
*.db-journal
*.db-wal
*.db-shm

# Signing credentials — never commit. Listed before the pipelines that produce them
# (plans/launch.md Increments 4 and 7) because a key committed once is in the history
# forever, and this repo goes public (Increment 10). Kept at the root rather than per
# app: a downloaded credential lands wherever the person happened to be, and these
# patterns match at any depth. If one is ever committed anyway, the fix is to *rotate
# the credential* — a history rewrite alone does not reach forks, clones, or CI caches.
*.p12
AuthKey_*.p8
*.mobileprovision
*.jks
*.keystore
credentials.json

# Local configuration — where the credentials above live on this machine, and anything
# else a build needs that is not the same everywhere. `.env.example` is the tracked
# template and must stay tracked.
.env
.env.*
!.env.example

*.swp
*.swo

.DS_Store
Thumbs.db

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

package-lock.json
yarn.lock

# tsc --build leaves these beside the tsconfig they belong to.
*.tsbuildinfo
