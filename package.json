{
  "name": "leapsake",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0",
  "scripts": {
    "android": "pnpm --filter @leapsake/mobile android",
    "desktop": "pnpm --filter @leapsake/desktop dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "icons": "node scripts/icons.mjs",
    "ios": "pnpm --filter @leapsake/mobile ios",
    "lint": "oxlint",
    "mobile": "pnpm --filter @leapsake/mobile dev",
    "release": "node scripts/release/index.mjs",
    "server": "pnpm --filter @leapsake/server dev",
    "test": "node scripts/test-all.mjs --fast",
    "test:all": "node scripts/test-all.mjs",
    "test:bundle": "pnpm --filter @leapsake/desktop check:bundle",
    "test:coverage": "node scripts/ensure-sqlite-abi.mjs node && vitest run --config vitest.coverage.config.ts",
    "test:docs": "node scripts/docs-manifest.mjs --check",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:format": "oxfmt --check .",
    "test:icons": "node scripts/icons.mjs --check",
    "test:integration": "node scripts/ensure-sqlite-abi.mjs node && vitest run apps",
    "test:lint": "oxlint",
    "test:native": "node scripts/test-native.mjs",
    "test:node": "node scripts/ensure-sqlite-abi.mjs node && vitest run",
    "test:secrets": "node scripts/secret-scan.mjs",
    "test:types": "pnpm -r typecheck",
    "test:unit": "node scripts/ensure-sqlite-abi.mjs node && vitest run packages",
    "test:versions": "node scripts/set-version.mjs --check",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.11",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">= 10.0.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">= 24.0.0",
    "pnpm": ">= 10.0.0"
  },
  "packageManager": "pnpm@10.17.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3-multiple-ciphers",
      "electron"
    ],
    "patchedDependencies": {
      "expo-modules-core@56.0.16": "patches/expo-modules-core@56.0.16.patch",
      "expo-contacts@56.0.13": "patches/expo-contacts@56.0.13.patch",
      "react-native-screens@4.25.2": "patches/react-native-screens@4.25.2.patch"
    },
    "overrides": {
      "@xmldom/xmldom@0.8": "^0.8.15",
      "@xmldom/xmldom@0.9": "^0.9.12",
      "baseline-browser-mapping@2": "^2.11.0",
      "brace-expansion@5": "^5.0.12",
      "browserslist@4": "^4.28.7",
      "fast-uri@3": "^3.1.8",
      "js-yaml@4": "^4.3.2",
      "nanoid@3": "^3.3.18",
      "postcss@8": "^8.5.23",
      "shell-quote@1": "^1.9.0",
      "undici@7": "^7.29.1",
      "undici@8": "^8.10.2"
    }
  }
}
