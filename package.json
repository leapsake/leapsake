{
  "name": "leapsake",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0",
  "scripts": {
    "android": "pnpm --filter @leapsake/mobile android",
    "desktop": "pnpm --filter @leapsake/desktop dev",
    "ios": "pnpm --filter @leapsake/mobile ios",
    "mobile": "pnpm --filter @leapsake/mobile dev",
    "format": "oxfmt . '!**/*.md'",
    "format:check": "oxfmt --check . '!**/*.md'",
    "lint": "oxlint",
    "test": "node scripts/ensure-sqlite-abi.mjs node && vitest run",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">= 24.0.0",
    "pnpm": ">= 10.0.0"
  },
  "packageManager": "pnpm@10.17.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3-multiple-ciphers",
      "electron"
    ]
  }
}
