{
  "expo": {
    "name": "Leapsake",
    "slug": "leapsake",
    "orientation": "portrait",
    "scheme": "leapsake",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.leapsake.app",
      "infoPlist": {
        "EXDevMenuShowFloatingActionButton": false,
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": ["facetime", "geo"]
      }
    },
    "android": {
      "package": "com.leapsake.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fbf7f0"
      },
      "queries": [
        { "intent": { "action": "android.intent.action.VIEW", "data": { "scheme": "geo" } } },
        { "intent": { "action": "android.intent.action.SENDTO", "data": { "scheme": "smsto" } } },
        { "intent": { "action": "android.intent.action.DIAL", "data": { "scheme": "tel" } } },
        { "intent": { "action": "android.intent.action.VIEW", "data": { "scheme": "https" } } }
      ]
    },
    "web": {},
    "experiments": {
      "reactCompiler": true
    },
    "plugins": [
      "expo-status-bar",
      ["expo-sqlite", { "useSQLCipher": true }],
      "expo-router",
      [
        "expo-contacts",
        { "contactsPermission": "Leapsake reads your contacts so you can import them as People." }
      ],
      "expo-notifications"
    ]
  }
}
