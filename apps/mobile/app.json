{
  "expo": {
    "name": "Leapsake",
    "slug": "leapsake",
    "orientation": "portrait",
    "scheme": "leapsake",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.leapsake.app"
    },
    "android": {
      "package": "com.leapsake.app"
    },
    "web": {},
    "plugins": [
      "expo-status-bar",
      ["expo-sqlite", { "useSQLCipher": true }],
      "expo-router",
      [
        "expo-contacts",
        { "contactsPermission": "Leapsake reads your contacts so you can import them as People." }
      ],
      "expo-notifications"
    ]
  }
}
