{
  "name": "@leapsake/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start --dev-client",
    "ios": "node ../../scripts/ios-prebuilt-flavour.mjs && expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@leapsake/bytes": "workspace:*",
    "@leapsake/contact-links": "workspace:*",
    "@leapsake/core": "workspace:*",
    "@leapsake/crypto": "workspace:*",
    "@leapsake/data": "workspace:*",
    "@leapsake/highlight": "workspace:*",
    "@leapsake/notifications": "workspace:*",
    "@leapsake/schema": "workspace:*",
    "@leapsake/store-layout": "workspace:*",
    "@leapsake/ui": "workspace:*",
    "@leapsake/vcard": "workspace:*",
    "@leapsake/view-models": "workspace:*",
    "@react-native-picker/picker": "2.11.4",
    "expo": "^56.0.11",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.18",
    "expo-contacts": "~56.0.13",
    "expo-crypto": "~56.0.4",
    "expo-dev-client": "~56.0.20",
    "expo-file-system": "~56.0.11",
    "expo-linking": "~56.0.14",
    "expo-localization": "~56.0.6",
    "expo-notifications": "~56.0.23",
    "expo-router": "~56.2.10",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.26",
    "expo-sqlite": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "react": "catalog:",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "catalog:",
    "jsdom": "^29.1.1",
    "react-dom": "catalog:",
    "typescript": "^6.0.3"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-contacts"
        ]
      }
    }
  }
