{
  "name": "@leapsake/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/index.mjs",
    "start": "node dist/index.mjs",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@leapsake/bytes": "workspace:*",
    "@leapsake/schema": "workspace:*",
    "@leapsake/sync": "workspace:*",
    "proxy-addr": "^2.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@leapsake/core": "workspace:*",
    "@leapsake/crypto": "workspace:*",
    "@leapsake/data": "workspace:*",
    "@types/proxy-addr": "^2.0.3",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.0"
  }
}
