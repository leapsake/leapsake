---
// The page shell and the only stylesheet, derived from `@leapsake/ui/tokens`;
// see the README's _Styling_.
import { color, fontSize, fontWeight, radius, space } from "@leapsake/ui/tokens";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

const kebab = (key: string) => key.replace(/[A-Z]/g, (c) => `-${c.toLowerCase()}`);

const customProperties = [
  ...Object.entries(color).map(([k, v]) => `--color-${kebab(k)}: ${v};`),
  ...Object.entries(space).map(([k, v]) => `--space-${kebab(k)}: ${v}px;`),
  ...Object.entries(fontSize).map(([k, v]) => `--font-size-${kebab(k)}: ${v}px;`),
  ...Object.entries(fontWeight).map(([k, v]) => `--font-weight-${kebab(k)}: ${v};`),
  ...Object.entries(radius).map(([k, v]) => `--radius-${kebab(k)}: ${v}px;`),
].join("\n      ");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {/* The order matters; see the README's _Icons_. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <slot name="head" />
    <style is:global set:html={`:root {\n      ${customProperties}\n    }`}></style>
    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding: var(--space-xl) var(--space-lg);
        background: var(--color-surface);
        color: var(--color-text);
        font-family:
          system-ui,
          -apple-system,
          "Segoe UI",
          sans-serif;
        font-size: var(--font-size-body);
        line-height: 1.6;
      }

      header,
      main {
        /* ~65 characters: the measure long-form prose is comfortable at. */
        max-width: 34rem;
        margin: 0 auto;
      }

      header {
        margin-bottom: var(--space-xl);
      }

      header a {
        color: var(--color-text);
        font-weight: var(--font-weight-semibold);
        text-decoration: none;
      }

      h1,
      h2 {
        line-height: 1.25;
      }

      h1 {
        font-size: var(--font-size-title);
      }

      h2 {
        font-size: var(--font-size-section-title);
        margin-top: var(--space-xl);
      }

      a {
        color: var(--color-accent);
      }

      em {
        color: var(--color-muted);
        font-style: normal;
        font-size: var(--font-size-detail);
      }

      footer {
        margin-top: var(--space-xl);
        padding-top: var(--space-lg);
        border-top: 1px solid var(--color-divider);
        color: var(--color-muted);
        font-size: var(--font-size-detail);
      }
    </style>
  </head>
  <body>
    <header>
      <a href="/">Leapsake</a>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
