---
import Base from "../layouts/Base.astro";

/**
 * A placeholder, and deliberately so. The marketing page is its own piece of work —
 * it needs positioning copy and the visual pass this scaffold does not have yet.
 * What it must do today is exist, so that the policy URL is not an orphan page on a
 * domain with nothing behind it.
 */
---

<Base
  title="Leapsake"
  description="A private place to remember the people you care about."
>
  <h1>A private place to remember the people you care about.</h1>
  <p>
    Leapsake runs on your device. It has no analytics, no trackers, and no server to
    send your information to.
  </p>
  <footer>
    <a href="/follow">Follow</a> · <a href="/privacy">Privacy policy</a>
  </footer>
</Base>
