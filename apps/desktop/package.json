{
  "name": "@leapsake/desktop",
  "version": "0.0.0",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "electron-rebuild -w better-sqlite3",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "prestart": "electron-rebuild -w better-sqlite3",
    "start": "electron-vite preview",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "pnpm rebuild better-sqlite3",
    "typecheck": "tsc --noEmit --composite false -p tsconfig.node.json && tsc --noEmit --composite false -p tsconfig.web.json"
  },
  "dependencies": {
    "@leapsake/data": "workspace:*",
    "@leapsake/schema": "workspace:*",
    "better-sqlite3": "^12.10.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.16.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^41.7.1",
    "electron-vite": "^5.0.0",
    "vite": "^7.3.3"
  }
}
