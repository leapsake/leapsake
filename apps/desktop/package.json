{
  "name": "@leapsake/desktop",
  "version": "0.0.0",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node ../../scripts/ensure-sqlite-abi.mjs electron && electron-vite dev",
    "build": "electron-vite build",
    "check:bundle": "node scripts/check-single-react.mjs",
    "rebuild": "node ../../scripts/ensure-sqlite-abi.mjs electron",
    "start": "node ../../scripts/ensure-sqlite-abi.mjs electron && electron-vite preview",
    "typecheck": "tsc --noEmit --composite false -p tsconfig.node.json && tsc --noEmit --composite false -p tsconfig.web.json"
  },
  "dependencies": {
    "@leapsake/bytes": "workspace:*",
    "@leapsake/contact-import": "workspace:*",
    "@leapsake/core": "workspace:*",
    "@leapsake/crypto": "workspace:*",
    "@leapsake/data": "workspace:*",
    "@leapsake/highlight": "workspace:*",
    "@leapsake/schema": "workspace:*",
    "@leapsake/sync": "workspace:*",
    "@leapsake/ui": "workspace:*",
    "@leapsake/view-models": "workspace:*",
    "better-sqlite3-multiple-ciphers": "^12.11.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "^7.16.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^41.7.1",
    "electron-vite": "^5.0.0",
    "vite": "^7.3.3"
  }
}
