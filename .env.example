# Copy to `.env` and fill in. `.env` is gitignored; this template is not.
#
# Nothing secret belongs in `.env` itself — the credentials are *files*, and this names
# where they are. The one real secret is the `.p8`, which is why it is referenced by path
# and why `AuthKey_*.p8`, `*.p12` and `*.mobileprovision` are gitignored at any depth.
#
# A variable already set in the environment wins over this file, so a CI runner's secrets
# are never overridden by a checked-out copy.
#
# Only the release path reads these; everything else in the repo runs without them.
# Check what a given release needs with:  pnpm release <stage> --only=<target> --dry-run

# ── iOS ─────────────────────────────────────────────────────────────────────────────────
# The Apple Developer team the archive is signed for. Visible at
# developer.apple.com → Membership.
APPLE_TEAM_ID=

# The *name* of an App Store distribution provisioning profile, created explicitly at
# developer.apple.com → Certificates, Identifiers & Profiles → Profiles. Not a managed
# one: the release signs manually, because automatic signing resolves development
# profiles too and fails on a machine with no registered device.
IOS_PROVISIONING_PROFILE=

# An App Store Connect API key, from App Store Connect → Users and Access → Integrations.
# The .p8 can only be downloaded once. Keep its `AuthKey_<key id>.p8` filename — the
# uploader finds the key by name, not by path.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=

# The App Store Connect **external** tester group a beta build is added to, by name. Create
# it in App Store Connect → TestFlight → Testers and Groups; the name here is the whole
# contract, so renaming the group there breaks the release until this matches again.
#
# The key above must be **App Manager** to use it: a Developer-role key uploads builds
# perfectly well and cannot touch beta groups or submit for review. The preflight makes one
# live API call to say so before the archive rather than after the upload.
ASC_BETA_GROUP=

# ── Android ─────────────────────────────────────────────────────────────────────────────
# The Play **upload key** — not the app signing key. Under Play App Signing, Google holds
# the key that signs what users install and this one only proves an upload is yours. That
# split is what makes a lost key a support ticket rather than a dead listing, and it is why
# a future transfer to the company account costs users nothing.
#
# Create one with:
#   keytool -genkeypair -keystore ~/.leapsake/leapsake-upload.jks -alias leapsake-upload \
#           -keyalg RSA -keysize 4096 -validity 10000
#
# `*.jks` and `*.keystore` are gitignored at any depth; keeping it outside the repo as well
# is belt and braces.
LEAPSAKE_ANDROID_KEYSTORE=
LEAPSAKE_ANDROID_KEY_ALIAS=

# The keystore password, as a **file** — the password itself never belongs in this file.
# `scripts/release/targets/android.mjs` will read it and pass it to Gradle in the child
# environment (that target is still a stub); until then, export
# LEAPSAKE_ANDROID_KEYSTORE_PASSWORD yourself for a one-off `./gradlew bundleRelease`. The
# child-environment route is also how a runner would supply it from a secret.
LEAPSAKE_ANDROID_KEYSTORE_PASSWORD_PATH=

# The service account `scripts/release/play.mjs` authenticates with, as a path to the JSON
# key Google hands out. Grant it "Release apps to testing tracks" and nothing more — the
# production release permission is a separate, later grant.
#
#   1. Enable https://console.cloud.google.com/apis/library/androidpublisher.googleapis.com
#   2. Create the account and key at https://console.cloud.google.com/iam-admin/serviceaccounts
#   3. Play Console → Users and permissions → invite the …iam.gserviceaccount.com address
#
# `credentials.json` is gitignored at any depth; keep it in ~/.leapsake/ regardless.
PLAY_SERVICE_ACCOUNT_PATH=

# ── Optional ────────────────────────────────────────────────────────────────────────────
# Pins the build number instead of deriving it from the clock. Set this only to rebuild
# an artifact for an upload that already happened; leave it empty otherwise, or every
# build will try to reuse a number the store has already seen.
LEAPSAKE_BUILD_NUMBER=
